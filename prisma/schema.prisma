generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Listing {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  price        String
  location     String
  city         String   @default("Dubai")
  propertyType String   @default("Residential")
  category     String   @default("Apartment")
  beds         Int
  baths        Int
  sqft         String
  image        String
  status       String   @default("FOR SALE")
  developerId  String?
  projectId    String?
  galleryImages String[] @default([])
  description  String?
  features     String[] @default([])
  overview     String?
  directionLink String?
  unitNo       String?
  floor        String?
  unitType     String?
  subType      String?
  view         String?
  internalArea String?
  externalArea String?
  specifications Json?
  amenities    Json?
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Developer {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  logo        String
  coverImage  String?
  description String?
  website     String?
  order       Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// An off plan project (e.g. "Verdana Apartments") by one developer. Off plan listings belong to a project.
model OffPlanProject {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  slug          String   @unique
  developerId   String
  coverImage    String?
  galleryImages String[] @default([])
  location      String?
  propertyTypes String?
  bedrooms      String?
  startingPrice String?
  handover      String?
  discount      String?
  description   String?
  order         Int      @default(0)
  isVisible     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ContactMessage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String
  phone       String?
  inquiryType String   @default("General")
  message     String
  createdAt   DateTime @default(now())
  read        Boolean  @default(false)
}

model Blog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  image       String?
  author      String   @default("Mohd. Alfalasi")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value String
}

model Agent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  role        String
  image       String
  phone       String?
  email       String?
  whatsapp    String?
  languages   String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faq {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  question  String
  answer    String
  page      String   @default("Home")
  subpage   String?
  category  String   @default("general")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
